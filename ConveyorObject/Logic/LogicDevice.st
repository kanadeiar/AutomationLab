FUNCTION_BLOCK LogicDevice
VAR_INPUT
    // Сигнал: коробка появилась на стартовой позиции (от инвертированного НЗ датчика SensorA)
    BoxOnStart: BOOL;
    // Сигнал: коробка дошла до конечной позиции (от инвертированного НЗ датчика SensorB)
    BoxOnEnd: BOOL;
END_VAR
VAR_OUTPUT
    // Команда: вращать ленту конвейера (TRUE — включить, FALSE — выключить)
    ComRotate: BOOL;
END_VAR

// ============================================
// ЛОГИКА УПРАВЛЕНИЯ ЛЕНТОЙ КОНВЕЙЕРА
// ============================================
// RS-триггер с самоподхватом:
// — Включение (SET):    коробка обнаружена на старте
// — Выключение (RESET): коробка дошла до конца ленты
// — Пока коробка в пути: лента вращается (самоподхват)
// ============================================

ComRotate := (BoxOnStart OR ComRotate) AND NOT BoxOnEnd;