FUNCTION_BLOCK Hardware
VAR_INPUT
    // Команда на вращение ленты от логического блока
    ComRotate: BOOL;
END_VAR
VAR_OUTPUT
    // Коробка обнаружена на старте (инвертированный НЗ датчик)
    BoxOnStart: BOOL;
    // Коробка обнаружена в конце (инвертированный НЗ датчик)
    BoxOnEnd: BOOL;
END_VAR

// ============================================
// БЛОК ЧТЕНИЯ АППАРАТУРЫ (ЖЕЛЕЗО — ВХОД)
// ============================================
// Отвечает только за чтение физических датчиков.
// Не пишет в GVL — это делает HardwareOutput.
// ============================================

// Чтение НЗ датчиков (инверсия в активный уровень)
BoxOnStart := NOT GVL.DI_SensorA;
BoxOnEnd   := NOT GVL.DI_SensorB;

// ============================================
// БЛОК ЗАПИСИ НА АППАРАТУРУ (ЖЕЛЕЗО — ВЫХОД)
// ============================================
// Отвечает за запись команд управления на физические выходы ПЛК.
// Не читает GVL — это делает Hardware (Input).
// ============================================

// Запись команды на двигатель
GVL.DO_ComMotor := ComRotate;